# Server Port (assigned automatically by cloud platforms like Render/Railway/Heroku)
PORT=5000

# Secret key for signing JWT tokens (generate a long random string for production)
JWT_SECRET=super_secret_production_jwt_key_smkc_2026

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# In production, set to your deployed Vercel domain e.g., https://fieldsetu.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# Node Environment
NODE_ENV=production
